# 本地配置（含账号信息，勿提交）
config/config.yaml
config/secrets.local.yaml
# 账号注册表与 DPAPI 密文凭据库：都是本机运行态数据
config/accounts.yaml
config/secrets.dpapi.json
.env

# 虚拟环境与缓存
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# PyInstaller 打包产物
build/
dist/

# 运行产物
logs/
/data/
@AutomationLog.txt
*.log

# 第三方二进制（柜台提供的 CTP dll 自行放到 ctp/vendor_libs，旧目录 ctp/api 也认，不入库）
ctp/vendor_libs/*.dll
ctp/api/*.dll

# 系统文件
Thumbs.db
Desktop.ini
.DS_Store

# 编辑器
.idea/
.vscode/

# 工具临时产物
.trae/
.trae-html-share-packages/
