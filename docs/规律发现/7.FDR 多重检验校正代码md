# 三、FDR Benjamini–Hochberg 校正代码（直接接入你前面置换检验）
逻辑：
1. 批量循环一堆因子，每个因子跑置换检验，收集所有p值
2. BH校正，输出校正后的p值（adjusted p）
3. 设定阈值（比如0.05），用校正后的p来筛选，而不是原始p

```python
# %%
# FDR Benjamini–Hochberg 多重检验校正
import numpy as np
import pandas as pd

def bh_fdr_correction(p_values: list, alpha: float = 0.05):
    """
    Benjamini–Hochberg FDR校正
    返回：df包含原始p、校正后p、是否显著
    """
    p_arr = np.asarray(p_values)
    n = len(p_arr)
    # 排序+记录原索引
    order = np.argsort(p_arr)
    p_sorted = p_arr[order]
    # BH公式
    bh_thresholds = np.arange(1, n+1) / n * alpha
    adjusted_p = p_sorted * n / np.arange(1, n+1)
    # 保证单调不减（BH标准修正）
    for i in range(n-2, -1, -1):
        adjusted_p[i] = min(adjusted_p[i], adjusted_p[i+1])
    # 放回原顺序
    res = np.zeros_like(p_arr)
    res[order] = adjusted_p
    out_df = pd.DataFrame({
        "raw_p": p_arr,
        "adjusted_p": res,
        "significant": res < alpha
    })
    return out_df

# ---------------- 批量置换示例（对接你之前的 permutation_test_ic） ----------------
factor_list = ["ret", "vol_5", "vol_20", "mom_10", "vol_ratio"]
target_col = "future_ret_5"
raw_p_list = []
ic_list = []

for f in factor_list:
    test_df = bar_df[[f, target_col]].dropna()
    ic_real, perm_ic_dist, p = permutation_test_ic(test_df, f, target_col, n_perm=800)
    raw_p_list.append(p)
    ic_list.append(ic_real)
    print(f"因子 {f} | IC={ic_real:.4f} | raw p={p:.4f}")

# FDR校正
fdr_result = bh_fdr_correction(raw_p_list, alpha=0.05)
fdr_result["factor"] = factor_list
fdr_result["ic"] = ic_list
fdr_result = fdr_result[["factor","ic","raw_p","adjusted_p","significant"]]

print("\n===== FDR BH校正结果 =====")
display(fdr_result.round(4))
```
> 使用规则：**判断是否显著，看 adjusted_p，不要看raw_p**
